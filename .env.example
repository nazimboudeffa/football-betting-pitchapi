# Betting Matrix — configuration (PitchAPI est l'unique source de donnees)
# Copiez ce fichier vers .env et renseignez votre clé.

# Clé API PitchAPI (obligatoire)
PITCHAPI_KEY=

# Délai maximal d'une requête PitchAPI (millisecondes)
PITCHAPI_TIMEOUT_MS=10000

# Saisons PitchAPI disponibles (2026 = saison 2026/2027)
PITCHAPI_SEASONS=2026,2025

# Saison par défaut pour l'interface (2026 = saison 2026/2027)
APP_DEFAULT_SEASON=2026

# Fuseau utilisé pour l'affichage des dates
APP_TIMEZONE=Europe/Paris

# Précharger le cache au démarrage (true/false)
AUTO_WARMUP=false
